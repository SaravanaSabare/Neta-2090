{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug neta (windowed)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/neta.exe",
            "args": ["--seed", "482913"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Pretty-print for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build (Debug)"
        },
        {
            "name": "Debug neta (headless)",
            "type": "cppdbg",
