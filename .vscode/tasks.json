{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (Debug)",
            "type": "shell",
            "command": "cmake --preset debug",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": false },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake --build --preset debug",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cmake --build --preset release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Run (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/neta.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared" },
            "dependsOn": ["Build (Debug)"]
        },
        {
            "label": "Run headless",
            "type": "shell",
            "command": "${workspaceFolder}/build/debug/neta.exe --headless --ticks 60 --seed 482913",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "ctest --preset debug",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
